# LINE Login channel (https://developers.line.biz/console/) — add callback URL:
#   http://localhost:3000/api/auth/line/callback and https://lpk-koeisuwan.vercel.app/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# OpenAI API key for the playground's AI tools (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Daily usage limit store (Upstash Redis REST). Required in production; local dev falls back to memory.
# Vercel Marketplace → Upstash sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
